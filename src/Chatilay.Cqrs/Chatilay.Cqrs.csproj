<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Chatilay.Cqrs</PackageId>
        <RootNamespace>Chatilay.Cqrs</RootNamespace>
        <AssemblyName>Chatilay.Cqrs</AssemblyName>
        <Description>A lightweight CQRS / mediator layer built on a single ICommandQueryRequest abstraction, with cached handler dispatch and assembly-scanning DI registration.</Description>
        <PackageTags>cqrs;mediator;dispatcher;handler;chatilay</PackageTags>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2"/>
    </ItemGroup>

</Project>
